# ============================================================
# check-cx 面板环境变量
# 复制为 .env.check-cx 并填入真实值
# ============================================================

# Supabase 项目配置（从 Supabase 控制台 → Project Settings → API 获取）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_OR_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 节点标识（多节点部署时区分，单节点保持 local 即可）
CHECK_NODE_ID=local

# 检测间隔（秒），范围 15–600，默认 60
CHECK_POLL_INTERVAL_SECONDS=60

# 最大并发检测数，范围 1–20，默认 5
CHECK_CONCURRENCY=5

# 官方状态页轮询间隔（秒），范围 60–3600，默认 300
OFFICIAL_STATUS_CHECK_INTERVAL_SECONDS=300

# 历史记录保留天数，范围 7–365，默认 30
HISTORY_RETENTION_DAYS=30
