# ============================================================
# check-cx-admin 后台环境变量
# 复制为 .env.check-cx-admin 并填入真实值
# ============================================================

# Supabase 项目配置（与 check-cx 共用同一个 Supabase 项目）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_OR_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 后台对外访问地址（用于 GitHub OAuth 回调，必须与 Supabase Auth 白名单一致）
APP_URL=https://check-admin.tcp.red

# 数据库 schema，默认 public
SUPABASE_DB_SCHEMA=public

# OAuth 提供商，固定 github
SUPABASE_OAUTH_PROVIDERS=github

# Bootstrap 管理员邮箱（你的 GitHub 账号绑定邮箱，首次登录用）
# 多个邮箱用英文逗号分隔
ADMIN_EMAILS=your-github-email@example.com
